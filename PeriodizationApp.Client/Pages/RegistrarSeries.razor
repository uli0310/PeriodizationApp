@page "/registrar"
@page "/registrar/{SessionId:guid}"
@page "/registrar-series/{SessionId:guid}"
@page "/sesion/{SessionId:guid}"

@using PeriodizationApp.Core.Entities
@using System.Timers
@implements IDisposable
@inject HttpClient Http
@inject UserSessionService Session
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>Entrenamiento en Vivo - Odysseus</PageTitle>

<style>
    input[type=number]::-webkit-inner-spin-button,
    input[type=number]::-webkit-outer-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    input[type=number] {
        -moz-appearance: textfield;
    }
</style>

<!-- =========================================================
     BARRA SUPERIOR DE ENTRENAMIENTO ACTIVO ESTILO HEVY
     ========================================================= -->
<MudPaper Elevation="4" Class="pa-3 mb-4" Style="background: linear-gradient(145deg, #1c1f26, #15171c); border: 1px solid rgba(59, 130, 246, 0.3); border-radius: 16px; position: sticky; top: 68px; z-index: 100;">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <MudText Typo="Typo.h5" Class="fw-bold">
                    🏋️‍♂️ @(sesionActual != null ? sesionActual.Name : $"Entrenamiento Libre ({Session.Username})")
                </MudText>
                <MudChip T="string" Color="Color.Info" Size="Size.Small" Icon="@Icons.Material.Filled.Timer">
                    @FormatearDuracion(segundosSesionActiva)
                </MudChip>
            </div>
            <div class="d-flex flex-wrap gap-3 mt-1">
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    Volumen: <strong class="text-success">@($"{TonelajeTotalSesion:N0} kg")</strong>
                </MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    Series Completadas: <strong class="text-primary">@TotalSeriesCompletadas</strong>
                </MudText>
                @if (TotalPRsSesion > 0)
                {
                    <MudText Typo="Typo.caption" Color="Color.Warning" Class="fw-bold">
                        🏆 @TotalPRsSesion PR(s) hoy
                    </MudText>
                }
            </div>
        </div>

        <div class="d-flex gap-2 align-items-center flex-wrap">
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Info"
                       Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Science"
                       OnClick="@(() => mostrarEvidenciaSesion = !mostrarEvidenciaSesion)">
                🔬 Evidencia
            </MudButton>

            <MudButton Variant="Variant.Outlined"
                       Color="Color.Secondary"
                       Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Album"
                       OnClick="@(() => AbrirCalculadoraDiscos(weightParaCalculadora))">
                💿 Discos
            </MudButton>

            <MudButton Variant="Variant.Outlined"
                       Color="Color.Warning"
                       Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Pets"
                       OnClick="ToggleModoGato">
                @(modoGatoActivo ? "Ocultar Michi" : "Michi")
            </MudButton>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Success"
                       Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Flag"
                       OnClick="FinalizarEntrenamientoEstiloHevyAsync">
                Finalizar
            </MudButton>
        </div>
    </div>

    <!-- CRONÓMETRO DE DESCANSO AUTOMÁTICO INTEGRADO -->
    @if (descansoActivo || segundosRestantesDescanso > 0)
    {
        var porcentajeDescanso = segundosTotalesDescanso > 0
            ? Math.Round((segundosRestantesDescanso / (double)segundosTotalesDescanso) * 100.0, 0)
            : 0;

        <div class="mt-3 pt-2" style="border-top: 1px solid rgba(255,255,255,0.08);">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-1">
                <div class="d-flex align-items-center gap-2">
                    <MudIcon Icon="@Icons.Material.Filled.HourglassTop" Color="Color.Info" Size="Size.Small" />
                    <MudText Typo="Typo.body2" Class="fw-bold text-info">
                        Descanso Activo: @FormatearTiempo(segundosRestantesDescanso)
                    </MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        (@motivoDescansoActual)
                    </MudText>
                </div>
                <div class="d-flex gap-1">
                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Info" OnClick="@(() => AjustarDescanso(-15))">-15s</MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Info" OnClick="@(() => AjustarDescanso(30))">+30s</MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Error" OnClick="DetenerDescanso">Saltar</MudButton>
                </div>
            </div>
            <MudProgressLinear Color="Color.Info" Value="@porcentajeDescanso" Rounded="true" Size="Size.Medium" />
        </div>
    }
</MudPaper>

<!-- PANEL DE EVIDENCIA CIENTÍFICA DESPLEGABLE -->
@if (mostrarEvidenciaSesion)
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Biotech" Class="mb-4" Style="background-color: rgba(56, 189, 248, 0.06); border-radius: 14px;">
        <div class="d-flex justify-content-between align-items-start">
            <MudText Typo="Typo.subtitle2" Color="Color.Info" Class="fw-bold mb-1">
                📚 ¿Por qué está estructurada así tu sesión de hoy? (Evidencia Científica)
            </MudText>
            <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Color="Color.Info" OnClick="@(() => mostrarEvidenciaSesion = false)" />
        </div>
        <ul class="mb-1 ps-3" style="font-size: 0.86rem;">
            <li><strong>1. Priorización Multiarticular (SNC Fresco):</strong> Los ejercicios compuestos pesados inician la sesión cuando no existe fatiga central ni periférica, permitiendo reclutar unidades motoras de alto umbral y sostener mayor carga mecánica (<em>Simão et al., 2012</em>).</li>
            <li><strong>2. Hipertrofia Mediada por Estiramiento:</strong> La selección incluye ejercicios con pico de tensión en máxima elongación sarcomérica (como <em>Curl Femoral Sentado</em>, <em>Extensión sobre la Cabeza</em> y <em>Press Inclinado con Mancuernas</em>), que generan hasta un 30–40% más de hipertrofia regional (<em>Maeo et al., 2021; Pedrosa et al., 2022</em>).</li>
            <li><strong>3. Tipos de Serie (W / N / F / D) y Descanso (3:00 vs 1:30):</strong> Las series de calentamiento (<strong>W</strong>, RIR &ge; 5) preparan el tejido conectivo sin generar fatiga; las series efectivas (<strong>1-3</strong>, RIR 1-2) maximizan tensión mecánica; y descansar 3 min en compuestos resintetiza ~95% del ATP-PCr (<em>Schoenfeld et al., 2016</em>).</li>
        </ul>
    </MudAlert>
}

@if (exercises == null)
{
    <div class="d-flex align-items-center gap-3 my-5">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        <MudText><em>Preparando tus tarjetas de entrenamiento...</em></MudText>
    </div>
}
else
{
    <div class="row">
        <!-- =========================================================
             COLUMNA PRINCIPAL: TARJETAS DE EJERCICIOS APILADAS (ESTILO HEVY)
             ========================================================= -->
        <div class="@(modoGatoActivo ? "col-lg-8" : "col-lg-12")">

            @foreach (var bloque in bloquesEjercicio)
            {
                var sugerencia = ObtenerSugerenciaBloque(bloque);

                <MudCard Elevation="3" Class="mb-4 pa-3" Style="background: linear-gradient(145deg, #1c1f26, #15171c); border: 1px solid rgba(255, 255, 255, 0.07); border-radius: 16px;">
                    <MudCardContent Class="pa-2">
                        <!-- CABECERA DEL EJERCICIO -->
                        <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-2">
                            <div>
                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                    <MudText Typo="Typo.h6" Color="Color.Primary" Class="fw-bold">
                                        @bloque.Ejercicio.Name
                                    </MudText>
                                    <MudChip T="string" Size="Size.Small" Color="@(bloque.Ejercicio.IsCompound ? Color.Success : Color.Info)">
                                        @(bloque.Ejercicio.IsCompound ? "⚡ Compuesto (3:00)" : "🎯 Aislamiento (1:30)")
                                    </MudChip>
                                    @if (!string.IsNullOrWhiteSpace(bloque.EnfoqueBiomecanico))
                                    {
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info">
                                            @bloque.EnfoqueBiomecanico
                                        </MudChip>
                                    }
                                </div>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    Músculos: @bloque.Ejercicio.MuscleGroup
                                    @if (bloque.RecordHistorico1RM > 0)
                                    {
                                        <span> &nbsp;|&nbsp; 🏆 Mejor e1RM previo: <strong class="text-warning">@bloque.RecordHistorico1RM kg</strong></span>
                                    }
                                </MudText>
                            </div>

                            <div class="d-flex align-items-center gap-1">
                                <MudIconButton Icon="@Icons.Material.Filled.Album"
                                               Color="Color.Info"
                                               Size="Size.Small"
                                               title="Ver discos por lado en la barra"
                                               OnClick="@(() => AbrirCalculadoraDiscos(bloque.Filas.FirstOrDefault()?.Peso ?? 60m))" />
                                <MudIconButton Icon="@Icons.Material.Filled.OndemandVideo"
                                               Color="Color.Error"
                                               Size="Size.Small"
                                               title="Ver técnica en YouTube"
                                               Href="@ObtenerLinkYouTube(bloque.Ejercicio.Name)"
                                               Target="_blank" />
                                <MudIconButton Icon="@Icons.Material.Filled.Close"
                                               Color="Color.Default"
                                               Size="Size.Small"
                                               title="Quitar ejercicio de la vista de hoy"
                                               OnClick="@(() => QuitarBloqueEjercicio(bloque))" />
                            </div>
                        </div>

                        <!-- BANNER DE SUGERENCIA DE SOBRECARGA PROGRESIVA -->
                        @if (sugerencia != null)
                        {
                            <div class="px-3 py-2 mb-3 rounded-3 d-flex justify-content-between align-items-center flex-wrap gap-2"
                                 style="background-color: rgba(59, 130, 246, 0.08); border: 1px solid rgba(59, 130, 246, 0.22);">
                                <small class="text-light">
                                    💡 <strong>Meta de Sobrecarga hoy:</strong>
                                    <span class="text-success fw-bold">@sugerencia.PesoSugerido kg × @sugerencia.RepsSugeridas reps</span>
                                    <span class="text-muted">(@sugerencia.Motivo)</span>
                                </small>
                            </div>
                        }

                        <!-- TABLA DE SERIES ESTILO HEVY -->
                        <div class="table-responsive">
                            <table class="table table-dark table-borderless align-middle mb-2" style="background: transparent;">
                                <thead>
                                    <tr class="text-muted" style="font-size: 0.75rem; border-bottom: 1px solid rgba(255,255,255,0.08);">
                                        <th style="width: 65px;">SERIE</th>
                                        <th>ANTERIOR</th>
                                        <th class="text-center" style="width: 90px;">KG</th>
                                        <th class="text-center" style="width: 85px;">REPS</th>
                                        <th class="text-center" style="width: 75px;">RIR</th>
                                        <th class="text-center">e1RM</th>
                                        <th class="text-end" style="width: 65px;">✓</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int idx = 0; idx < bloque.Filas.Count; idx++)
                                    {
                                        var fila = bloque.Filas[idx];
                                        var numVisual = idx + 1;
                                        var e1rmFila = SetRecord.ComputeScientific1RM(fila.Peso, fila.Reps, fila.Rir);

                                        <tr class="hevy-set-row @(fila.Completada ? "completed" : "")">
                                            <!-- TIPO DE SERIE (TOCABLE: N / W / F / D) -->
                                            <td>
                                                <MudButton Size="Size.Small"
                                                           Variant="Variant.Outlined"
                                                           Color="@ObtenerColorTipoSerie(fila.TipoSerie)"
                                                           Style="min-width: 44px; font-weight: 800; padding: 2px 6px;"
                                                           title="Toca para cambiar: Normal / W (Calentamiento) / F (Fallo) / D (Drop Set)"
                                                           OnClick="@(() => CiclarTipoSerie(fila, numVisual))">
                                                    @(fila.TipoSerie == "N" ? numVisual.ToString() : fila.TipoSerie)
                                                </MudButton>
                                            </td>

                                            <!-- COLUMNA ANTERIOR + BADGE DE PR -->
                                            <td>
                                                <small class="text-muted d-block" style="font-size: 0.8rem;">
                                                    @(bloque.UltimoRegistro != null
                                                        ? $"{bloque.UltimoRegistro.Weight}kg × {bloque.UltimoRegistro.ActualReps} @RIR {bloque.UltimoRegistro.ActualRIR}"
                                                        : "—")
                                                </small>
                                                @if (fila.EsNuevoPR)
                                                {
                                                    <span class="badge bg-warning text-dark fw-bold mt-1">
                                                        🏆 ¡NUEVO PR!
                                                    </span>
                                                }
                                            </td>

                                            <!-- INPUT KG -->
                                            <td class="text-center">
                                                <input type="number"
                                                       class="hevy-input"
                                                       step="1.25"
                                                       disabled="@fila.Completada"
                                                       @bind="fila.Peso" />
                                            </td>

                                            <!-- INPUT REPS -->
                                            <td class="text-center">
                                                <input type="number"
                                                       class="hevy-input"
                                                       style="width: 62px;"
                                                       disabled="@fila.Completada"
                                                       @bind="fila.Reps" />
                                            </td>

                                            <!-- INPUT RIR -->
                                            <td class="text-center">
                                                <input type="number"
                                                       class="hevy-input"
                                                       style="width: 56px;"
                                                       min="0"
                                                       max="10"
                                                       disabled="@fila.Completada"
                                                       @bind="fila.Rir" />
                                            </td>

                                            <!-- e1RM EN VIVO -->
                                            <td class="text-center">
                                                <small class="text-info fw-bold">@e1rmFila kg</small>
                                            </td>

                                            <!-- BOTÓN CHECK ✓ ESTILO HEVY -->
                                            <td class="text-end">
                                                <MudIconButton Icon="@(fila.Completada ? Icons.Material.Filled.CheckBox : Icons.Material.Filled.CheckBoxOutlineBlank)"
                                                               Color="@(fila.Completada ? Color.Success : Color.Default)"
                                                               Size="Size.Medium"
                                                               Disabled="@fila.Guardando"
                                                               OnClick="@(() => ToggleCheckSerieAsync(bloque, fila, numVisual))" />
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- BOTÓN + AGREGAR SERIE AL EJERCICIO -->
                        <MudButton Variant="Variant.Text"
                                   Color="Color.Primary"
                                   FullWidth="true"
                                   Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Add"
                                   Style="background-color: rgba(255,255,255,0.03); border-radius: 10px;"
                                   OnClick="@(() => AgregarFilaSerie(bloque))">
                            + Agregar Serie
                        </MudButton>
                    </MudCardContent>
                </MudCard>
            }

            <!-- TARJETA PARA AGREGAR OTRO EJERCICIO A LA SESIÓN -->
            <MudCard Elevation="2" Class="mb-4 pa-3" Style="background: linear-gradient(145deg, #1c1f26, #15171c); border: 1px dashed rgba(59, 130, 246, 0.4); border-radius: 16px;">
                <MudCardContent Class="py-2">
                    <MudGrid Class="align-items-center">
                        <MudItem xs="12" sm="8">
                            <select class="form-select bg-dark text-white border-secondary" @bind="ejercicioParaAgregarId">
                                <option value="@Guid.Empty">-- + Añadir otro ejercicio del catálogo (@exercises.Count disponibles) --</option>
                                @foreach (var ex in exercises.OrderBy(e => e.Name))
                                {
                                    <option value="@ex.Id">@ex.Name (@ex.MuscleGroup)</option>
                                }
                            </select>
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       FullWidth="true"
                                       StartIcon="@Icons.Material.Filled.AddCircleOutline"
                                       OnClick="AgregarEjercicioSeleccionadoAsync">
                                Agregar Ejercicio
                            </MudButton>
                        </MudItem>
                    </MudGrid>
                </MudCardContent>
            </MudCard>
        </div>

        <!-- =========================================================
             COLUMNA LATERAL: MURAL MOTIVACIONAL MICHI
             ========================================================= -->
        @if (modoGatoActivo)
        {
            <div class="col-lg-4 mb-4">
                <div class="card border-0 bg-dark text-white p-3 shadow-lg" style="position: sticky; top: 175px;">
                    <div class="card-body d-flex flex-column justify-content-between">
                        <div>
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h5 class="fw-bold mb-0 text-warning">😹 COACH MICHI</h5>
                                <span class="badge bg-danger rounded-pill">🔥 MODO FITCAT</span>
                            </div>

                            <div class="overflow-hidden rounded-3 mb-3 border border-secondary shadow-sm" style="height: 260px;">
                                <img src="@imagenesMichis[indiceImagenActual]" class="img-fluid w-100 h-100" style="object-fit: cover;" alt="Meme Gato Mamado" />
                            </div>
                        </div>

                        <div class="p-3 rounded-3" style="background-color: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.07);">
                            <div class="d-flex align-items-center">
                                <span class="fs-3 me-3">🐈‍⬛</span>
                                <div>
                                    <small class="text-warning d-block fw-bold">EL MICHI DICE:</small>
                                    <small class="text-light" style="font-style: italic;">"@consejoActual"</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

<!-- =========================================================
     MODAL 1: CALCULADORA VISUAL DE DISCOS POR LADO (PLATE CALCULATOR)
     ========================================================= -->
@if (mostrarCalculadoraDiscos)
{
    var desgloseDiscos = CalcularDiscosPorLado(weightParaCalculadora, pesoBarraOlimpica);

    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.78); backdrop-filter: blur(5px); z-index: 1400;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" style="background-color: #1c1f26; border: 1px solid rgba(59, 130, 246, 0.4); border-radius: 18px;">
                <div class="modal-header border-bottom-0 pb-0">
                    <h5 class="modal-title fw-bold text-info">💿 Calculadora Visual de Discos (Por Lado)</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => mostrarCalculadoraDiscos = false"></button>
                </div>
                <div class="modal-body text-light">
                    <div class="row mb-3">
                        <div class="col-7">
                            <label class="form-label small text-muted">Peso Total Objetivo (kg)</label>
                            <div class="input-group">
                                <button class="btn btn-outline-secondary" type="button" @onclick="() => weightParaCalculadora = Math.Max(20, weightParaCalculadora - 2.5m)">-2.5</button>
                                <input type="number" class="form-control bg-dark text-white text-center fw-bold" step="1.25" @bind="weightParaCalculadora" />
                                <button class="btn btn-outline-secondary" type="button" @onclick="() => weightParaCalculadora += 2.5m">+2.5</button>
                            </div>
                        </div>
                        <div class="col-5">
                            <label class="form-label small text-muted">Peso de la Barra</label>
                            <select class="form-select bg-dark text-white border-secondary" @bind="pesoBarraOlimpica">
                                <option value="20">20 kg (Olímpica)</option>
                                <option value="15">15 kg (Femenina/Semi)</option>
                                <option value="10">10 kg (Barra EZ)</option>
                                <option value="0">0 kg (Máquina/Prensa)</option>
                            </select>
                        </div>
                    </div>

                    <div class="p-3 rounded-3 mb-3 text-center" style="background-color: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08);">
                        <small class="text-muted d-block mb-2">
                            CARGAR EN <strong>CADA LADO</strong> DE LA BARRA (@((weightParaCalculadora - pesoBarraOlimpica) / 2m) kg por lado):
                        </small>

                        @if (!desgloseDiscos.Any())
                        {
                            <span class="badge bg-secondary fs-6">Solo la barra (@pesoBarraOlimpica kg)</span>
                        }
                        else
                        {
                            <div class="d-flex justify-content-center align-items-center flex-wrap gap-2 my-2">
                                <span class="badge bg-secondary px-2 py-2">Barra @pesoBarraOlimpica kg ║</span>
                                @foreach (var disco in desgloseDiscos)
                                {
                                    <span class="badge px-3 py-2 fw-bold shadow-sm"
                                          style="@($"background-color: {disco.ColorHex}; color: {disco.TextoHex}; font-size: 0.95rem; border-radius: 8px;")">
                                        @disco.Peso kg
                                    </span>
                                }
                            </div>
                        }
                    </div>
                </div>
                <div class="modal-footer border-top-0 pt-0">
                    <button type="button" class="btn btn-primary w-100 fw-bold" @onclick="() => mostrarCalculadoraDiscos = false">Listo</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- =========================================================
     MODAL 2: TARJETA RESUMEN POST-ENTRENAMIENTO ESTILO HEVY
     ========================================================= -->
@if (mostrarResumenFinal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.82); backdrop-filter: blur(6px); z-index: 1450;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" style="background-color: #1c1f26; border: 2px solid #10b981; border-radius: 20px;">
                <div class="modal-body text-light text-center p-4">
                    <div class="mb-2" style="font-size: 3rem;">🏆</div>
                    <h3 class="fw-bold text-success mb-1">¡Entrenamiento Completado!</h3>
                    <p class="text-muted mb-4">
                        @(sesionActual != null ? sesionActual.Name : $"Sesión de {Session.Username}") • @DateTime.Now.ToString("dd/MM/yyyy")
                    </p>

                    <div class="row g-2 mb-4">
                        <div class="col-4">
                            <div class="p-3 rounded-3" style="background-color: rgba(59, 130, 246, 0.12);">
                                <small class="text-info d-block fw-bold">DURACIÓN</small>
                                <span class="fs-5 fw-bold">@FormatearDuracion(segundosSesionActiva)</span>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="p-3 rounded-3" style="background-color: rgba(16, 185, 129, 0.12);">
                                <small class="text-success d-block fw-bold">TONELAJE</small>
                                <span class="fs-5 fw-bold">@($"{TonelajeTotalSesion:N0} kg")</span>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="p-3 rounded-3" style="background-color: rgba(245, 158, 11, 0.12);">
                                <small class="text-warning d-block fw-bold">RÉCORDS</small>
                                <span class="fs-5 fw-bold">@TotalPRsSesion PR(s)</span>
                            </div>
                        </div>
                    </div>

                    @if (listaPRsLogradosHoy.Any())
                    {
                        <div class="text-start p-3 rounded-3 mb-4" style="background-color: rgba(245, 158, 11, 0.08); border: 1px solid rgba(245, 158, 11, 0.3);">
                            <small class="text-warning fw-bold d-block mb-2">🌟 RÉCORDS PERSONALES ROTOS HOY:</small>
                            @foreach (var pr in listaPRsLogradosHoy)
                            {
                                <div class="small text-light mb-1">• @pr</div>
                            }
                        </div>
                    }

                    <div class="d-flex gap-2">
                        <MudButton Variant="Variant.Outlined" Color="Color.Default" FullWidth="true" OnClick="@(() => mostrarResumenFinal = false)">
                            Seguir Editando
                        </MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Success" FullWidth="true" OnClick="@(() => Navigation.NavigateTo("/progreso"))">
                            Ver Dashboard Progreso
                        </MudButton>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public Guid? SessionId { get; set; }

    private List<Exercise>? exercises;
    private WorkoutSession? sesionActual;

    // Estructura Estilo Hevy: Bloques de Ejercicio -> Filas de Series
    private List<BloqueEjercicioHevy> bloquesEjercicio = new();
    private Guid ejercicioParaAgregarId = Guid.Empty;

    private bool mostrarEvidenciaSesion = false;
    private bool mostrarCalculadoraDiscos = false;
    private bool mostrarResumenFinal = false;
    private bool modoGatoActivo = false;

    private decimal weightParaCalculadora = 80m;
    private decimal pesoBarraOlimpica = 20m;

    // Cronómetro de sesión activa y cronómetro de descanso
    private Timer? timerSesion;
    private int segundosSesionActiva = 0;

    private Timer? timerDescanso;
    private bool descansoActivo = false;
    private int segundosRestantesDescanso = 0;
    private int segundosTotalesDescanso = 180;
    private string motivoDescansoActual = "3:00 min recomendados";

    private Timer? timerMemes;
    private int indiceImagenActual = 0;
    private List<string> listaPRsLogradosHoy = new();

    private readonly string[] imagenesMichis = {
        "Cat.jpg",
        "Gato.jpg",
        "Kitty.jpg",
        "michi1.jpg"
    };

    private readonly string[] consejosGatos = {
        "¿Descansando más de 3 minutos? A menos que sea sentadilla o peso muerto pesado, ¡es hora de la siguiente serie!",
        "La sobrecarga progresiva se construye repetición a repetición. ¡Haz que esta serie cuente!",
        "Controla la fase excéntrica y aprovecha el estiramiento: la ciencia y la hipertrofia están de tu lado.",
        "Odysseus no regresó a Ítaca saltándose el día de pierna. ¡A darle con todo a esos cuádriceps!",
        "La técnica no es negociable: rango completo de movimiento, estabilidad y máxima tensión mecánica.",
        "Mantén tu RIR entre 1 y 2: ahí es donde ocurre el verdadero reclutamiento de fibras sin quemar tu sistema nervioso."
    };
    private string consejoActual = "";

    private decimal TonelajeTotalSesion =>
        bloquesEjercicio.SelectMany(b => b.Filas).Where(f => f.Completada).Sum(f => f.Peso * f.Reps);

    private int TotalSeriesCompletadas =>
        bloquesEjercicio.SelectMany(b => b.Filas).Count(f => f.Completada);

    private int TotalPRsSesion =>
        bloquesEjercicio.SelectMany(b => b.Filas).Count(f => f.Completada && f.EsNuevoPR);

    private class FilaSerieHevy
    {
        public Guid? SetRecordIdGuardado { get; set; }
        public string TipoSerie { get; set; } = "N"; // N = Normal, W = Warmup, F = Fallo, D = DropSet
        public decimal Peso { get; set; } = 20m;
        public int Reps { get; set; } = 8;
        public int Rir { get; set; } = 2;
        public bool Completada { get; set; } = false;
        public bool Guardando { get; set; } = false;
        public bool EsNuevoPR { get; set; } = false;
    }

    private class BloqueEjercicioHevy
    {
        public Exercise Ejercicio { get; set; } = default!;
        public string EnfoqueBiomecanico { get; set; } = string.Empty;
        public SetRecord? UltimoRegistro { get; set; }
        public decimal RecordHistorico1RM { get; set; }
        public decimal RecordHistoricoPeso { get; set; }
        public List<FilaSerieHevy> Filas { get; set; } = new();
    }

    private record SugerenciaSobrecarga(decimal PesoSugerido, int RepsSugeridas, string Motivo);
    private record DiscoOlimpico(decimal Peso, string ColorHex, string TextoHex);

    protected override async Task OnInitializedAsync()
    {
        await Session.InitializeAsync();
        exercises = await Http.GetFromJsonAsync<List<Exercise>>("api/Exercises") ?? new();

        List<SetRecord> seriesExistentesSesion = new();

        if (SessionId.HasValue)
        {
            try
            {
                sesionActual = await Http.GetFromJsonAsync<WorkoutSession>($"api/WorkoutSessions/{SessionId.Value}");
            }
            catch { }

            try
            {
                seriesExistentesSesion = await Http.GetFromJsonAsync<List<SetRecord>>($"api/SetRecords/session/{SessionId.Value}") ?? new();
            }
            catch { }
        }

        await ConstruirTarjetasInicialesEstiloHevyAsync(seriesExistentesSesion);

        consejoActual = consejosGatos[0];

        timerSesion = new Timer(1000);
        timerSesion.Elapsed += (_, _) =>
        {
            segundosSesionActiva++;
            InvokeAsync(StateHasChanged);
        };
        timerSesion.AutoReset = true;
        timerSesion.Start();

        timerMemes = new Timer(10000);
        timerMemes.Elapsed += RotarMeme;
        timerMemes.AutoReset = true;
        timerMemes.Start();

        timerDescanso = new Timer(1000);
        timerDescanso.Elapsed += TickDescanso;
        timerDescanso.AutoReset = true;
    }

    private async Task ConstruirTarjetasInicialesEstiloHevyAsync(List<SetRecord> seriesExistentesSesion)
    {
        bloquesEjercicio.Clear();

        // 1. Si la sesión ya tenía series guardadas, reconstruimos sus bloques primero
        foreach (var grupo in seriesExistentesSesion.GroupBy(s => s.ExerciseId))
        {
            var ex = exercises?.FirstOrDefault(e => e.Id == grupo.Key);
            if (ex != null)
            {
                var bloque = await CrearBloqueEjercicioAsync(ex, "Registrado en esta sesión", 0);
                foreach (var sr in grupo)
                {
                    bloque.Filas.Add(new FilaSerieHevy
                    {
                        SetRecordIdGuardado = sr.Id,
                        TipoSerie = sr.ActualRIR >= 5 ? "W" : (sr.ActualRIR == 0 ? "F" : "N"),
                        Peso = sr.Weight,
                        Reps = sr.ActualReps,
                        Rir = sr.ActualRIR,
                        Completada = true
                    });
                }
                bloquesEjercicio.Add(bloque);
            }
        }

        // 2. Agregamos los ejercicios prescritos de la plantilla del día que aún no estén en la lista
        var plantilla = ObtenerPlantillaPorNombreSesion(sesionActual?.Name ?? "Upper");
        foreach (var item in plantilla)
        {
            var match = exercises?.FirstOrDefault(e => e.Name.Contains(item.NombreParcial, StringComparison.OrdinalIgnoreCase));
            if (match != null && !bloquesEjercicio.Any(b => b.Ejercicio.Id == match.Id))
            {
                var bloque = await CrearBloqueEjercicioAsync(match, item.Enfoque, item.Series);
                bloquesEjercicio.Add(bloque);
            }
        }
    }

    private (string NombreParcial, int Series, string Enfoque)[] ObtenerPlantillaPorNombreSesion(string nombreSesion)
    {
        if (nombreSesion.Contains("Lower", StringComparison.OrdinalIgnoreCase) ||
            nombreSesion.Contains("Legs", StringComparison.OrdinalIgnoreCase) ||
            nombreSesion.Contains("Pierna", StringComparison.OrdinalIgnoreCase))
        {
            return new[]
            {
                ("Sentadilla Libre con Barra", 3, "Compuesto Prioritario"),
                ("Peso Muerto Rumano (RDL)", 3, "Bisagra / Estiramiento Isquios"),
                ("Prensa de Piernas", 3, "Cuádriceps Alta Estabilidad"),
                ("Curl de Isquiotibiales Sentado", 3, "Hipertrofia en Máximo Estiramiento"),
                ("Extensiones de Cuádriceps", 3, "Aislamiento Recto Femoral"),
                ("Elevación de Talones de Pie", 3, "Estiramiento Gastrocnemio")
            };
        }
        if (nombreSesion.Contains("Push", StringComparison.OrdinalIgnoreCase) ||
            nombreSesion.Contains("Empuje", StringComparison.OrdinalIgnoreCase))
        {
            return new[]
            {
                ("Press de Banca Plano con Barra", 3, "Compuesto Fuerza"),
                ("Press de Banca Inclinado con Mancuernas", 3, "Estiramiento Pecho Superior"),
                ("Press Militar con Barra", 3, "Compuesto Hombro"),
                ("Elevaciones Laterales en Polea", 3, "Tensión Constante Lateral"),
                ("Extensión por Encima de la Cabeza en Polea", 3, "Máximo Estiramiento Cabeza Larga")
            };
        }
        if (nombreSesion.Contains("Pull", StringComparison.OrdinalIgnoreCase) ||
            nombreSesion.Contains("Tracción", StringComparison.OrdinalIgnoreCase))
        {
            return new[]
            {
                ("Dominadas", 3, "Tracción Vertical Prioritaria"),
                ("Remo en Máquina (Chest-Supported)", 3, "Alta Estabilidad / Menor Fatiga SNC"),
                ("Jalón al Pecho en Polea", 3, "Dorsal Ancho"),
                ("Face Pull en Polea", 3, "Deltoides Posterior / Salud Escapular"),
                ("Curl de Bíceps en Polea Baja", 3, "Estiramiento de Bíceps")
            };
        }
