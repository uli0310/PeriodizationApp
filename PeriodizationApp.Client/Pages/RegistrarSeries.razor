        {
            return new[]
            {
                ("Sentadilla Libre con Barra", 3, "Patrón Rodilla"),
                ("Press de Banca Inclinado con Mancuernas", 3, "Empuje Horizontal"),
                ("Dominadas", 3, "Tracción Vertical"),
                ("Peso Muerto Rumano (RDL)", 2, "Bisagra de Cadera"),
                ("Elevaciones Laterales en Polea", 3, "Deltoides Lateral")
            };
        }

        return new[]
        {
            ("Press de Banca Plano con Barra", 3, "Empuje Horizontal"),
            ("Dominadas", 3, "Tracción Vertical"),
            ("Press de Banca Inclinado con Mancuernas", 3, "Estiramiento Pecho Superior"),
            ("Remo en Máquina (Chest-Supported)", 3, "Tracción Horizontal Estable"),
            ("Elevaciones Laterales en Polea", 3, "Hombro Lateral"),
            ("Extensión por Encima de la Cabeza en Polea", 2, "Tríceps en Estiramiento"),
