        };
    }

    private async Task<BloqueEjercicioHevy> CrearBloqueEjercicioAsync(Exercise ex, string enfoque, int cantidadSeriesIniciales)
    {
        var bloque = new BloqueEjercicioHevy
        {
            Ejercicio = ex,
            EnfoqueBiomecanico = enfoque
        };

        try
        {
            var url = Session.UserId != Guid.Empty
                ? $"api/SetRecords/exercise/{ex.Id}?userId={Session.UserId}"
                : $"api/SetRecords/exercise/{ex.Id}";
            var historial = await Http.GetFromJsonAsync<List<SetRecord>>(url);
            if (historial != null && historial.Any())
            {
                bloque.UltimoRegistro = historial.Last();
                bloque.RecordHistorico1RM = historial.Max(h => h.Estimated1RM);
                bloque.RecordHistoricoPeso = historial.Max(h => h.Weight);
            }
        }
        catch { }

        var sug = ObtenerSugerenciaBloque(bloque);
        decimal pesoInicial = sug?.PesoSugerido ?? (ex.IsCompound ? 40m : 15m);
        int repsIniciales = sug?.RepsSugeridas ?? (ex.IsCompound ? 8 : 12);

        for (int i = 0; i < cantidadSeriesIniciales; i++)
        {
            bloque.Filas.Add(new FilaSerieHevy
            {
                TipoSerie = "N",
                Peso = pesoInicial,
                Reps = repsIniciales,
                Rir = 2
            });
        }

        return bloque;
    }

    private SugerenciaSobrecarga? ObtenerSugerenciaBloque(BloqueEjercicioHevy bloque)
    {
        if (bloque.UltimoRegistro == null) return null;
        var ultimo = bloque.UltimoRegistro;

        if (ultimo.ActualRIR >= 2)
        {
            var inc = bloque.Ejercicio.IsCompound ? 2.5m : 1.25m;
            return new SugerenciaSobrecarga(ultimo.Weight + inc, ultimo.ActualReps, $"Tenías RIR {ultimo.ActualRIR} → +{inc} kg");
        }
        if (ultimo.ActualRIR == 1)
        {
            return new SugerenciaSobrecarga(ultimo.Weight, ultimo.ActualReps + 1, "Zona RIR 1 → Doble Progresión (+1 rep)");
        }
        return new SugerenciaSobrecarga(ultimo.Weight, ultimo.ActualReps, "Llegaste a RIR 0 → Mantén carga hoy");
    }

    private void AgregarFilaSerie(BloqueEjercicioHevy bloque)
    {
        var ultima = bloque.Filas.LastOrDefault();
        bloque.Filas.Add(new FilaSerieHevy
        {
            TipoSerie = "N",
            Peso = ultima?.Peso ?? 20m,
            Reps = ultima?.Reps ?? 8,
            Rir = ultima?.Rir ?? 2
        });
    }

    private void QuitarBloqueEjercicio(BloqueEjercicioHevy bloque)
    {
        bloquesEjercicio.Remove(bloque);
    }

    private async Task AgregarEjercicioSeleccionadoAsync()
    {
        if (ejercicioParaAgregarId == Guid.Empty || exercises == null) return;
        var ex = exercises.FirstOrDefault(e => e.Id == ejercicioParaAgregarId);
        if (ex == null) return;

        var nuevoBloque = await CrearBloqueEjercicioAsync(ex, "Agregado Manualmente", 3);
        bloquesEjercicio.Add(nuevoBloque);
        ejercicioParaAgregarId = Guid.Empty;
    }

    private void CiclarTipoSerie(FilaSerieHevy fila, int numVisual)
    {
        if (fila.Completada) return;
        fila.TipoSerie = fila.TipoSerie switch
        {
            "N" => "W",
            "W" => "F",
            "F" => "D",
            _ => "N"
        };

        if (fila.TipoSerie == "W") fila.Rir = 5;
        else if (fila.TipoSerie == "F") fila.Rir = 0;
        else if (fila.TipoSerie == "D") fila.Rir = 1;
        else fila.Rir = 2;
    }

    private Color ObtenerColorTipoSerie(string tipo) => tipo switch
    {
        "W" => Color.Warning,
        "F" => Color.Error,
        "D" => Color.Secondary,
        _ => Color.Primary
    };

    private async Task ToggleCheckSerieAsync(BloqueEjercicioHevy bloque, FilaSerieHevy fila, int numVisual)
    {
        if (fila.Guardando) return;

        // Si ya estaba completada, desmarcarla y borrarla de PostgreSQL
        if (fila.Completada)
        {
            if (fila.SetRecordIdGuardado.HasValue)
            {
                fila.Guardando = true;
                await Http.DeleteAsync($"api/SetRecords/{fila.SetRecordIdGuardado.Value}");
                fila.Guardando = false;
            }
            fila.Completada = false;
            fila.EsNuevoPR = false;
            fila.SetRecordIdGuardado = null;
            Snackbar.Add("Serie desmarcada.", Severity.Info);
            return;
        }

        if (fila.Reps <= 0)
        {
            Snackbar.Add("Ingresa al menos 1 repetición antes de marcar la serie.", Severity.Warning);
            return;
        }

        fila.Guardando = true;
        var nuevoRecord = new SetRecord
        {
            Id = Guid.NewGuid(),
            UserId = Session.UserId != Guid.Empty ? Session.UserId : null,
            WorkoutSessionId = SessionId,
            ExerciseId = bloque.Ejercicio.Id,
            SetNumber = numVisual,
            Weight = fila.Peso,
            TargetReps = fila.Reps,
            ActualReps = fila.Reps,
            TargetRIR = 2,
            ActualRIR = fila.Rir,
            Notes = $"Tipo:{fila.TipoSerie}"
        };

        var response = await Http.PostAsJsonAsync("api/SetRecords", nuevoRecord);
        if (response.IsSuccessStatusCode)
        {
            var guardado = await response.Content.ReadFromJsonAsync<SetRecord>() ?? nuevoRecord;
            fila.SetRecordIdGuardado = guardado.Id;
            fila.Completada = true;

            // Detector de Récord Personal (PR) estilo Hevy para series efectivas (no calentamiento W)
            var e1rmLogrado = guardado.Estimated1RM;
            if (fila.TipoSerie != "W" && (e1rmLogrado > bloque.RecordHistorico1RM || fila.Peso > bloque.RecordHistoricoPeso))
            {
                fila.EsNuevoPR = true;
                bloque.RecordHistorico1RM = Math.Max(bloque.RecordHistorico1RM, e1rmLogrado);
                bloque.RecordHistoricoPeso = Math.Max(bloque.RecordHistoricoPeso, fila.Peso);

                var textoPr = $"{bloque.Ejercicio.Name}: {fila.Peso} kg × {fila.Reps} reps (Nuevo e1RM: {e1rmLogrado} kg)";
                listaPRsLogradosHoy.Add(textoPr);
                Snackbar.Add($"🏆 ¡NUEVO RÉCORD PERSONAL en {bloque.Ejercicio.Name}! (e1RM: {e1rmLogrado} kg)", Severity.Warning);
            }
            else
            {
                Snackbar.Add($"✓ Serie #{numVisual} de {bloque.Ejercicio.Name} completada", Severity.Success);
            }

            bloque.UltimoRegistro = guardado;
            IniciarDescansoInteligente(bloque.Ejercicio, fila.TipoSerie);
        }
        else
        {
            Snackbar.Add("No se pudo guardar la serie en la base de datos.", Severity.Error);
        }

        fila.Guardando = false;
    }

    private void IniciarDescansoInteligente(Exercise ejercicio, string tipoSerie)
    {
        if (tipoSerie == "W")
        {
            segundosTotalesDescanso = 60;
            motivoDescansoActual = "Serie de Calentamiento (1:00 min)";
        }
        else if (ejercicio.IsCompound)
        {
            segundosTotalesDescanso = 180;
            motivoDescansoActual = $"{ejercicio.Name} • Compuesto (3:00 min para ATP-PCr y SNC)";
        }
        else
        {
            segundosTotalesDescanso = 90;
            motivoDescansoActual = $"{ejercicio.Name} • Aislamiento (1:30 min)";
        }

        segundosRestantesDescanso = segundosTotalesDescanso;
        descansoActivo = true;
        timerDescanso?.Start();
    }

    private void TickDescanso(Object? source, ElapsedEventArgs e)
    {
        if (segundosRestantesDescanso > 0)
        {
            segundosRestantesDescanso--;
            if (segundosRestantesDescanso == 0)
            {
                descansoActivo = false;
                timerDescanso?.Stop();
                InvokeAsync(() =>
                {
                    Snackbar.Add("🔔 ¡Descanso terminado! Lista tu siguiente serie.", Severity.Info);
                    StateHasChanged();
                });
                return;
            }
            InvokeAsync(StateHasChanged);
        }
    }

    private void AjustarDescanso(int delta)
    {
        segundosRestantesDescanso = Math.Max(0, segundosRestantesDescanso + delta);
        if (segundosRestantesDescanso > segundosTotalesDescanso)
            segundosTotalesDescanso = segundosRestantesDescanso;
        if (segundosRestantesDescanso == 0)
            DetenerDescanso();
    }

    private void DetenerDescanso()
    {
        descansoActivo = false;
        segundosRestantesDescanso = 0;
        timerDescanso?.Stop();
    }

    private void AbrirCalculadoraDiscos(decimal peso)
    {
        weightParaCalculadora = peso > 0 ? peso : 60m;
        mostrarCalculadoraDiscos = true;
    }

    private List<DiscoOlimpico> CalcularDiscosPorLado(decimal pesoTotal, decimal pesoBarra)
    {
        var resultado = new List<DiscoOlimpico>();
        decimal restantePorLado = (pesoTotal - pesoBarra) / 2m;
        if (restantePorLado <= 0) return resultado;

        var catalogoDiscos = new (decimal Peso, string Bg, string Fg)[]
        {
            (25m, "#dc2626", "#ffffff"),   // Rojo Olímpico
            (20m, "#2563eb", "#ffffff"),   // Azul Olímpico
            (15m, "#eab308", "#000000"),   // Amarillo Olímpico
            (10m, "#16a34a", "#ffffff"),   // Verde Olímpico
            (5m, "#f8fafc", "#0f172a"),    // Blanco Olímpico
            (2.5m, "#334155", "#ffffff"),  // Negro
            (1.25m, "#94a3b8", "#0f172a")  // Plata Fraccional
        };

        foreach (var d in catalogoDiscos)
        {
            while (restantePorLado >= d.Peso)
            {
                resultado.Add(new DiscoOlimpico(d.Peso, d.Bg, d.Fg));
                restantePorLado -= d.Peso;
            }
        }

        return resultado;
    }

    private async Task FinalizarEntrenamientoEstiloHevyAsync()
    {
        if (sesionActual != null)
        {
            sesionActual.CompletedDate = DateTime.UtcNow;
            await Http.PutAsJsonAsync($"api/WorkoutSessions/{sesionActual.Id}", sesionActual);
        }

        DetenerDescanso();
        mostrarResumenFinal = true;
    }

    private string FormatearTiempo(int totalSegundos)
    {
        var mins = totalSegundos / 60;
        var secs = totalSegundos % 60;
        return $"{mins:D2}:{secs:D2}";
    }

    private string FormatearDuracion(int totalSegundos)
    {
        var hrs = totalSegundos / 3600;
        var mins = (totalSegundos % 3600) / 60;
        var secs = totalSegundos % 60;
        return hrs > 0 ? $"{hrs:D2}:{mins:D2}:{secs:D2}" : $"{mins:D2}:{secs:D2}";
    }

    private string ObtenerLinkYouTube(string nombre)
    {
        var query = Uri.EscapeDataString($"como hacer {nombre} tecnica correcta hipertrofia");
        return $"https://www.youtube.com/results?search_query={query}";
    }

    private void ToggleModoGato() => modoGatoActivo = !modoGatoActivo;

    private void RotarMeme(Object? source, ElapsedEventArgs e)
    {
        indiceImagenActual = (indiceImagenActual + 1) % imagenesMichis.Length;
        int nuevoIndiceConsejo = new Random().Next(consejosGatos.Length);
        consejoActual = consejosGatos[nuevoIndiceConsejo];
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        timerSesion?.Stop();
        timerSesion?.Dispose();
        timerMemes?.Stop();
        timerMemes?.Dispose();
        timerDescanso?.Stop();
        timerDescanso?.Dispose();
    }
}
